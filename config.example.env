# DeskPad Fold 설정 예시. 복사해서 config.env 로 저장하고 값을 고친 뒤
#   tools/deskpad-config config.env
# 를 실행하면 앱 설정(defaults, 도메인 com.joonlab.DeskPadFold)에 반영됩니다. config.env 는 git 에 올라가지 않습니다.
# 비워 두면 앱은 괄호 안 기본값을 씁니다.

# Deskreen CE 를 띄울 Chrome DevTools 포트 (기본 9333, 127.0.0.1 에만 열림)
DESKREEN_DEBUG_PORT=9333

# Deskreen CE 앱 경로 (기본 /Applications/Deskreen CE.app)
DESKREEN_APP_PATH="/Applications/Deskreen CE.app"

# 폰으로 보내는 스트림 해상도 비율, 0.25~1.0 (기본 0.75). 폰이 버벅이면 낮추고, 글자가 흐리면 올리세요.
DESKPAD_STREAM_SCALE=0.75
